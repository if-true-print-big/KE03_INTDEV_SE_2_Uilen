@model DataAccessLayer.Models.Customer

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Klant</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Naam
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            Adres
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Address)
        </dd>
        <dt class = "col-sm-2">
            Actief
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Active)
        </dd>
    </dl>
</div>

<div>
    <h4>Bestelgeschiedenis</h4>
    <hr />
    @if (Model.Orders.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Bestelling nummer</th>
                    <th>Datum</th>
                    <th>Klant ID</th>
                    <th>Klant Naam</th>
                    <th>Bestelling</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td>@order.Id</td>
                        <td>@order.OrderDate</td>
                        <td>@order.CustomerId</td>
                        <td>@order.Customer.Name</td>
                        <!--<td>string.Join(", ", order.OrderProducts.Product.Select(p => p.Name))</td>-->
                        @foreach (var orderproduct in order.OrderProducts)
                        {
                            <td>@orderproduct.Product.Name , @orderproduct.Quantity stuk(s)</td>
                        }

                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>Er zijn geen bestellingen.</p>
    }
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Bewerken</a> |
    <a asp-action="Index">Terug naar Lijst</a>
</div>
