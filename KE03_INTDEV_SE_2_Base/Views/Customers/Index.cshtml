@model IEnumerable<DataAccessLayer.Models.Customer>

@{
    ViewData["Title"] = "Index";
}

<h1>Klanten</h1>

<form method="get" asp-action="Index" class="mb-3">
    <input type="text" name="name" placeholder="Filter op naam" value="@Context.Request.Query["name"]" />
    <input type="text" name="address" placeholder="Filter op adres" value="@Context.Request.Query["address"]" />
    <select name="active">
        <option value="true" selected="@(Context.Request.Query["active"] == "true")">Actief</option>
        <option value="false" selected="@(Context.Request.Query["active"] == "false")">Inactief</option>
    </select>
    <button type="submit">Filter</button>
    <a asp-action="Index">Reset</a>
</form>

<p>
    <a asp-action="Create">Nieuwe klant</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>
                Naam
            </th>
            <th>
                Adres
            </th>
            <th>
                Actief
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Address)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Active)
            </td>
            <td>
                <a asp-action="Edit" 
                    asp-route-id="@item.Id"
                    class="btn btn-outline-primary btn-sm"> 
                    Bewerken
                </a>

                <a asp-action="Details" 
                    asp-route-id="@item.Id"
                    class="btn btn-outline-warning btn-sm">
                    Details
                </a> 

                <a asp-action="Delete"
                    asp-route-id="@item.Id"
                    class="btn btn-outline-danger btn-sm">
                    Verwijderen
                </a>
            </td>
        </tr>
}
    </tbody>
</table>
