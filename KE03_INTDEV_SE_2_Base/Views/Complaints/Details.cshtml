@model DataAccessLayer.Models.Complaint

@{
    ViewData["Title"] = "Details";
}

<h1>Klachtdetails</h1>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Beschrijving
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class = "col-sm-2">
            Status
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dt class = "col-sm-2">
            Klant
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Customer.Name)
        </dd>
    </dl>
</div>
<div>
    <form asp-action="ToggleStatus" asp-route-id="@Model.Id" method="post">
        <button class="btn btn-warning">
            Status wijzigen
        </button>
    </form>
    <a asp-action="Index"
       class="btn btn-secondary">
        Terug naar Lijst
    </a>
</div>
