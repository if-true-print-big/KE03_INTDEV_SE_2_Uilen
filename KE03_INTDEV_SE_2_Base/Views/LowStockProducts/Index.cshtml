@model List<DataAccessLayer.Models.Product>
@{
	ViewData["Title"] = "Index";
}

<h1>Lage Voorraad</h1>
<br>
<p>Alle producten die op dit moment een voorraad hebben die lager is dan het gekozen minimum, producten waar dit minimum niet gedefinieerd is worden niet meegenomen.</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Naam
            </th>
            <th>
                Voorraad
            </th>
            <th>
                Minimale Voorraad
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (DataAccessLayer.Models.Product Product in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => Product.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => Product.Stock)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => Product.MinimumStock)
                </td>
            </tr>
        }
    </tbody>
</table>