@model DataAccessLayer.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Home Page";
}

<h1>Dringende zaken</h1>
<br />
<div class="alert alert-info">
    <strong>Lage vooraad</strong><br />
    Er zijn @Model.numberOfProductsWithLowStock product(en) met een lage voorraad.
    <a asp-area="" asp-controller="ProductStock" asp-action="Index">Naar Voorraad</a>
</div>

<div class="alert alert-info">
    <strong>Nieuwe bestelling</strong><br />
    Er zijn @Model.numberOfOrdersWithErrorStatus nieuwe bestellingen die wachten op bevestiging door een bezorger.
    <a asp-area="" asp-controller="Orders" asp-action="PackageHandling">Naar Pakket Afhandelen</a>
</div>


<div class="alert alert-info">
    <strong>Open Klachten</strong><br  />
    Er zijn @Model.numberOfOpenComplaints klacht(en) met de status "Open".
    <a asp-area="" asp-controller="Complaints" asp-action="OpenComplaints">Naar Open Klachten</a>
</div>