@model DataAccessLayer.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Home Page";
}

<h1>Dringende zaken</h1>
<br />
<h4>Lage Voorraad</h4>
<p>Er zijn @Model.numberOfProductsWithLowStock product(en) met een lage voorraad. 
    <a asp-area="" asp-controller="ProductStock" asp-action="Index">Naar Voorraad</a>
</p>

<h4>Bestellingen met problemen</h4>
<p>Er zijn @Model.numberOfOrdersWithErrorStatus order(s) met de status "Error".
    <a asp-area="" asp-controller="Orders" asp-action="Index">Naar Orders</a>
</p>

<h4>Open klachten</h4>
<p>
    Er zijn @Model.numberOfOrdersWithErrorStatus klacht(en) met de status "Open".
    <a asp-area="" asp-controller="Complaints" asp-action="Index">Naar Klachten</a>
</p>