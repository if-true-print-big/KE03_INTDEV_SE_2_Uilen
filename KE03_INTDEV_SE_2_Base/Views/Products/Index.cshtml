@model IEnumerable<DataAccessLayer.Models.Product>

@{
    ViewData["Title"] = "Index";
}

<h1>Producten</h1>

<p>
    <a asp-action="Create">Nieuw Product</a>
</p>
<form asp-action="Index" method="get">
    <div class="input-group">
        <input type="search"
               class="form-control rounded"
               placeholder="Zoeken"
               name="searchString"
               value="@Context.Request.Query["searchString"]"
               aria-label="Search"
               aria-describedby="search-addon" />

        <button type="submit" class="btn btn-outline-primary">
            Zoeken
        </button>
    </div>
</form>


    @foreach (var item in Model)
    {
        <div class="productcard">
        <div class="productImg"><div class="square"></div></div>
        <div class="productInfo"><p>Serienummer: @Html.DisplayFor(modelItem => item.Id)</p>
            <p>Naam: @Html.DisplayFor(modelItem => item.Name)</p>
        </div>
        <div class="productInfo"><p>Beschrijving: @Html.DisplayFor(modelItem => item.Description)</p></div>
        <div class="productInfo"><p>Prijs: @Html.DisplayFor(modelItem => item.Price)</p></div>
        <div class="productInfo"><p>Voorraad: @Html.DisplayFor(modelItem => item.Stock)</p></div>
        <div class="productInfo">

                <a asp-action="Details"
                  asp-route-id="@item.Id"
                  class="btn btn-outline-primary btn-sm">
                  👁️
                 </a>

                <a asp-action="Edit" 
                    asp-route-id="@item.Id"
                    class="btn btn-outline-warning btn-sm">
                    ✏️
                </a>

                <a asp-action="Delete" 
                    asp-route-id="@item.Id"
                    class="btn btn-outline-danger btn-sm">
                    🗑️
                </a>
                </div>
        </div>
    }