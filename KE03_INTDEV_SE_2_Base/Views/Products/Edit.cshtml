@model DataAccessLayer.Models.Product

@{
    ViewData["Title"] = "Edit";
}

<h1>Bewerken</h1>

<h4>Product</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="ProductDisplay">
                <div class="productImg"><div class="square"></div></div>
            <input type="hidden" asp-for="Id" />
            <div class="productInfo2">
            <div class="form-group">
                <label asp-for="Name" class="control-label">Naam</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            </div>
            
            <div class="productInfo2">
            <div class="form-group">
                <label asp-for="Price" class="control-label">Prijs</label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CategoryId" class="control-label">Categorie</label>
                <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId"></select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            </div>
            <div class="productInfo2">
            <div class="form-group">
                <label asp-for="MinimumStock" class="control-label">Minimum Voorraad</label>
                <input asp-for="MinimumStock" class="form-control" />
                <span asp-validation-for="MinimumStock" class="text-danger"></span>
            </div>
            </div>
            </div>
            <div class="productInfo3">
                <div class="form-group">
                    <label asp-for="Description" class="control-label">Beschrijving</label>
                    <textarea class="form-control" id="Description" rows="3"></textarea>
                    
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Bevestigen" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Terug naar Lijst</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
