@model DataAccessLayer.Models.Product

@{
    ViewData["Title"] = "Delete";
}

<h1>Verwijderen</h1>

<h3>Weet u zeker dat u dit wilt verwijderen?</h3>

<div>
    <h4>Product</h4>
    <hr />
    <div class="ProductDisplay">
    <dl class="row">
            <div class="productImg"><div class="square"></div></div>
        <div class="productInfo2"> 
        <dt class = "col-sm-2">
            Naam
        </dt>

        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        </div>

        <div class="productInfo2">
        <dt class = "col-sm-2">
            Prijs
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Price)
        </dd>
        </div> 
        <div class="productInfo2">
        <dt class = "col-sm-2">
            Minimum Voorraad
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MinimumStock)
        </dd>
        </div>
        <div class="productInfo2">
        <dt class = "col-sm-2">
            Categorie
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Category.Name)
        </dd>
        </div>
    </dl>
    </div>
    <div class="productInfo3">
        <dt class="col-sm-2">
            Beschrijving
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
    </div>
</div>
<div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Verwijderen" class="btn btn-danger" /> |
        <a asp-action="Index">Terug naar Lijst</a>
    </form>
</div>
