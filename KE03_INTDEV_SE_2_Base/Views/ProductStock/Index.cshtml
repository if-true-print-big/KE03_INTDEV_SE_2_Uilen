@model DataAccessLayer.Models.ProductStockViewModel
@{
	ViewData["Title"] = "Index";
}

<h1>Lage Voorraad</h1>
<br>
<p>Alle producten die op dit moment een voorraad hebben die lager is dan het gekozen minimum, producten waar dit minimum niet gedefinieerd is worden niet meegenomen.</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Naam
            </th>
            <th>
                Voorraad
            </th>
            <th>
                Minimale Voorraad
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (DataAccessLayer.Models.Product Product in Model.productsWithLowStock)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => Product.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => Product.Stock)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => Product.MinimumStock)
                </td>
            </tr>
        }
    </tbody>
</table>

<h1>Producten zonder minimum voorraad</h1>
<p>Hier volgen alle producten waar minimum voorraad niet gedefinieerd is, zodat u de voorraad van deze producten niet uit het oog verliest.</p>

<table class="table">
    <thead>
        <tr>
            <th>
                Naam
            </th>
            <th>
                Voorraad
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (DataAccessLayer.Models.Product Product in Model.productsWithoutMinimumStock)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => Product.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => Product.Stock)
                </td>
            </tr>
        }
    </tbody>
</table>

<h1>Alle producten</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                Naam
            </th>
            <th>
                Voorraad
            </th>
            <th>
                Minimale Voorraad
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (DataAccessLayer.Models.Product Product in Model.allproducts)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => Product.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => Product.Stock)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => Product.MinimumStock)
                </td>
            </tr>
        }
    </tbody>
</table>