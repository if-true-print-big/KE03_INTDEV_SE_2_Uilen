@model IEnumerable<DataAccessLayer.Models.Order>

@{
    ViewData["Title"] = "Pakketafhandling";
}

<div class="container-fluid">

        <!-- Main content -->
        <div class="col-md-9">

            <div class="card">

                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3 mt-2 px-2">
                        <h2 class="mb-0">Pakket Afhandelen</h2>
                    </div>

                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Order Nummer</th>
                                <th>Order Datum</th>
                                <th>Klant</th>
                                <th>Adres</th>
                                <th class="status">Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.OrderDate</td>
                                    <td>@item.Customer?.Name</td>
                                    <td>@item.Customer?.Address</td>
                                    <td>@item.Status</td>

                                    <td>
                                    <a asp-action="PackageDetails"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-primary btn-sm"
                                       title="Details">
                                        👁️
                                    </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>

        </div>

</div>