@model IEnumerable<DataAccessLayer.Models.Order>

@{
    ViewData["Title"] = "Orders";
}

<div class="container-fluid">

    <div class="row">

    <!-- Left sidebar -->
    <div class="col-md-3">
            <div class="card">
                <div class="card-header">
                    <h4>Filters</h4>
                </div>
                
                <div class="card-body">
                                    
                    <!-- Filter Sidebar -->
                    <form asp-action="Index" method="get">

                        <div class="mb-3">
                            <label>Order Nummer</label>
                            <input name="orderNumber"
                                   value="@ViewBag.OrderNumber"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label>Naam Klant</label>

                            <input name="customerName"
                                   value="@ViewBag.CustomerName"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label>Adres</label>
                            <input name="address"
                                   value="@ViewBag.Address"
                                   class="form-control" />
                        </div>
                                                
                        <div class="mb-3">

                            <label>Status</label>

                            <select name="status"
                                    class="form-control">

                                <option value="">
                                    Alle
                                </option>

                                <option value="Ontvangen">
                                    Ontvangen
                                </option>

                                <option value="Verzonden">
                                    Verzonden
                                </option>

                                <option value="Error">
                                    Error
                                </option>

                            </select>

                        </div>

                        <button type="submit" class="btn btn-primary">
                            Zoek
                        </button>

                        <a asp-action="Index" class="btn btn-secondary">
                            Reset
                        </a>
                    </form>
                </div>

            </div>
    </div>

        <!-- Main content -->
        <div class="col-md-9">

            <div class="card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2>Orders</h2>

                    <a asp-action="Create"
                        class="btn btn-success">
                        Nieuw Order
                    </a>
                </div>
                <div class="card-body">

                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Order Nummer</th>
                                <th>Order Datum</th>
                                <th>Klant</th>
                                <th>Adres</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.OrderDate</td>
                                    <td>@item.Customer?.Name</td>
                                    <td>@item.Customer?.Address</td>
                                    <td>@item.Status</td>

                                    <td>
                                        <a asp-action="Details"
                                            asp-route-id="@item.Id"
                                            class="btn btn-outline-primary btn-sm">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                            asp-route-id="@item.Id"
                                            class="btn btn-outline-warning btn-sm">
                                            Bewerken
                                        </a>

                                        <a asp-action="Delete"
                                            asp-route-id="@item.Id"
                                            class="btn btn-outline-danger btn-sm">
                                            Verwijderen
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>

        </div>

    </div>

</div>