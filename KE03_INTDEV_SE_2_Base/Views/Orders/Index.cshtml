@model IEnumerable<DataAccessLayer.Models.Order>

@{
    ViewData["Title"] = "Orders";
}

<div class="container-fluid">

    <div class="row">

    <!-- Left sidebar -->
    <div class="col-md-3">
            <div class="card">
                <div class="card-header">
                    <h4>Filters</h4>
                </div>
                
                <div class="card-body">
                                    
                    <!-- Filter Sidebar -->
                    <form asp-action="Index" method="get">

                        <div class="mb-3">
                            <label>Order Number</label>
                            <input name="orderNumber"
                                   value="@ViewBag.OrderNumber"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label>Customer Name</label>

                            <input name="customerName"
                                   value="@ViewBag.CustomerName"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label>Address</label>
                            <input name="address"
                                   value="@ViewBag.Address"
                                   class="form-control" />
                        </div>
                                                
                        <div class="mb-3">

                            <label>Status</label>

                            <select name="status" class="form-control">

                                <option value="" selected="@(string.IsNullOrEmpty(ViewBag.Status) ? "selected" : null)">
                                    All
                                </option>

                                <option value="Received" selected="@(ViewBag.Status == "Received" ? "selected" : null)">
                                    Received
                                </option>

                                <option value="Sent" selected="@(ViewBag.Status == "Sent" ? "selected" : null)">
                                    Sent
                                </option>

                                <option value="Error" selected="@(ViewBag.Status == "Error" ? "selected" : null)">
                                    Something went wrong
                                </option>

                            </select>

                        </div>

                        <button type="submit" class="btn btn-primary">
                            Search
                        </button>

                        <a asp-action="Index" class="btn btn-secondary">
                            Reset
                        </a>
                    </form>
                </div>

            </div>
    </div>

        <!-- Main content -->
        <div class="col-md-9">

            <div class="card">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center mb-3 mt-2 px-2">
                        <h2 class="mb-0">Orders</h2>

                        <a asp-action="Create"
                           class="btn btn-success">
                            Create Order
                        </a>
                    </div>

                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Order Number</th>
                                <th>Order Date</th>
                                <th>Customer</th>
                                <th>Address</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.OrderDate</td>
                                    <td>@item.Customer?.Name</td>
                                    <td>@item.Customer?.Address</td>
                                    <td>@item.Status</td>

                                    <td>
                                        <a asp-action="Details"
                                            asp-route-id="@item.Id"
                                            class="btn btn-outline-primary btn-sm">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                            asp-route-id="@item.Id"
                                            class="btn btn-outline-warning btn-sm">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                            asp-route-id="@item.Id"
                                            class="btn btn-outline-danger btn-sm">
                                            Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>

        </div>

    </div>

</div>