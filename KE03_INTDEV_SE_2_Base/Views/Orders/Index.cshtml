@model IEnumerable<DataAccessLayer.Models.Order>

@{
    ViewData["Title"] = "Orders";
}

<div class="container-fluid">

    <div class="row">

    <!-- Left sidebar -->
    <div class="col-md-3">
            <div class="card">
                <div class="card-header">
                    <h4>Filters</h4>
                </div>
                
                <div class="card-body">
                                    
                    <!-- Filter Sidebar -->
                    <form asp-action="Index" method="get">

                        <div class="mb-3">
                            <label>Order Nummer</label>
                            <input name="orderNumber"
                                   value="@ViewBag.OrderNumber"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label>Naam Klant</label>

                            <input name="customerName"
                                   value="@ViewBag.CustomerName"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label>Adres</label>
                            <input name="address"
                                   value="@ViewBag.Address"
                                   class="form-control" />
                        </div>

                        <div class="border rounded p-2 mb-3">

                            <h6>Periode</h6>

                            <div class="mb-2">
                                <label>Van</label>
                                <input type="date"
                                       name="fromDate"
                                       value="@ViewBag.FromDate"
                                       class="form-control" />
                            </div>

                            <div>
                                <label>Tot</label>
                                <input type="date"
                                       name="toDate"
                                       value="@ViewBag.ToDate"
                                       class="form-control" />
                            </div>

                        </div>
                                                
                        <div class="mb-3">

                            <label>Status</label>

                            <select name="status" class="form-control">

                                <option value="" selected="@(string.IsNullOrEmpty(ViewBag.Status) ? "selected" : null)">
                                    Alle
                                </option>

                                <option value="Ontvangen" selected="@(ViewBag.Status == "Ontvangen" ? "selected" : null)">
                                    Ontvangen
                                </option>

                                <option value="Verzonden" selected="@(ViewBag.Status == "Verzonden" ? "selected" : null)">
                                    Verzonden
                                </option>

                                <option value="InRek" selected="@(ViewBag.Status == "Inrek" ? "selected" : null)">
                                    KVV
                                </option>

                                <option value="Bevestigd" selected="@(ViewBag.Status == "Bevestigd" ? "selected" : null)">
                                    Bevestigd
                                </option>

                                <option value="Error" selected="@(ViewBag.Status == "Error" ? "selected" : null)">
                                    Error
                                </option>

                            </select>

                        </div>

                        
                        <button type="submit" class="btn btn-primary">
                            Zoek
                        </button>

                        <a asp-action="Index" class="btn btn-secondary">
                            Reset
                        </a>
                    </form>
                </div>

            </div>
    </div>

        <!-- Main content -->
        <div class="col-md-9">

            <div class="card">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center mb-3 mt-2 px-2">
                        <h2 class="mb-0">Orders</h2>

                        <a asp-action="Create"
                           class="btn btn-success">
                            Nieuw Order
                        </a>
                    </div>

                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Order Nummer</th>
                                <th>Order Datum</th>
                                <th>Klant</th>
                                <th>Adres</th>
                                <th class="status">Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.OrderDate.ToString("dd-MM-yyyy")</td>
                                    <td>@item.Customer?.Name</td>
                                    <td>@item.Customer?.Address</td>
                                    <td>
                                        @(item.Status == DataAccessLayer.Models.Order.OrderStatus.InRek
                                            ? "KVV"
                                            : item.Status.ToString())
                                    </td>
                                    <td>
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-primary btn-sm"
                                           title="Details">
                                            👁️
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-warning btn-sm"
                                           title="Bewerken">
                                            ✏️
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-danger btn-sm"
                                           title="Verwijderen">
                                            🗑️
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>

        </div>

    </div>

</div>